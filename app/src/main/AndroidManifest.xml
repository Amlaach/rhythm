<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!--
      Only for the opt-in "write corrections into the files" setting, and only on
      the versions that still honour it. From Android 11 the system grants write
      access per file through its own dialog instead.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!--
      Scanning and analysing are minutes of work on a large library, and a
      cached process is frozen the moment the screen goes off. Without this
      the pass simply stopped, and someone with ten thousand files could not
      finish one without sitting and watching it.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Required to attach an audio effect to the player's own session. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!--
      Updates, for phones that have the internet (see update/Updater.kt). The
      app never goes online for anything else: the only request it makes is
      for the release's update.json and the APK it names, and without a
      working connection it makes none and shows nothing about updates.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        largeHeap: the recommender holds what it knows about every song, and
        a library of twenty thousand on a card is more than the default heap
        of a low end phone - 192 to 256 MB - leaves room for. Asking for the
        large heap roughly doubles that ceiling and changes nothing about
        what is computed. See "Known issue" in CLAUDE.md for the real fix.
    -->
    <application
        android:name=".RhythmApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:largeHeap="true"
        android:theme="@style/Theme.Rhythm">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Rhythm">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
        <service
            android:name=".data.LibraryWorkService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <receiver
            android:name=".update.UpdateReceiver"
            android:exported="false" />
        <receiver
            android:name=".playback.RhythmWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.elchanan.rhythm.widget.PREV" />
                <action android:name="com.elchanan.rhythm.widget.PLAY" />
                <action android:name="com.elchanan.rhythm.widget.NEXT" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
    </application>
</manifest>
