<?xml version="1.0" encoding="utf-8"?>
<!--
    Two separate layers, which is what Android asks for: the launcher shifts
    them slightly against each other for depth, and every manufacturer masks the
    result to a different shape - a circle on Pixel, a squircle on Samsung. The
    symbol therefore sits at half the canvas width, comfortably inside even the
    tightest of those masks.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
